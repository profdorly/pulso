# OpenAI API (Responses API — web search + structured outputs)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_EDITORIAL=gpt-6.1-sol
OPENAI_MODEL_WORKER=gpt-6-luna
# Worker fallback when OPENAI_MODEL_WORKER is unset.
OPENAI_MODEL=gpt-6-luna

# Artificial Analysis benchmark API (free key via https://artificialanalysis.ai/ signup)
# Optional: without it the model catalogue job keeps the last catalogue it had.
ARTIFICIAL_ANALYSIS_API_KEY=

# Spend ceiling per edition run (USD). Once reached, remaining model steps are skipped and
# the edition degrades to the free stub path instead of quietly costing more.
PULSO_MAX_EDITION_USD=4

# SQLite database file
DATABASE_PATH=./data/news.db

# Auditor de fidelidade dos textos: GPT-6.1 Sol com raciocínio baixo, um modelo diferente do
# GPT-6 Luna que escreve título, blurb e resumo. Medido em research/auditor-eval.md.
PULSO_AUDITOR_PROVIDER=openai
PULSO_AUDITOR_MODEL=gpt-6.1-sol
PULSO_AUDITOR_REASONING_EFFORT=low

# Busca na web além dos feeds (uma chamada por região).
# shadow → roda, confere link, data e tema, e registra no log sem publicar; ausente → desligada.
# PULSO_WEB_SEARCH=shadow
# OPENAI_MODEL_SEARCH=gpt-6.1-terra

# Armazenamento da cozinha (npm run kitchen / kitchen:export / kitchen:import): um bucket R2
# com o news.db, as cópias diárias em backups/ e os arquivos do Pulso da Semana em weekly/.
# KITCHEN_S3_ENDPOINT troca o endpoint do R2 por qualquer outro que fale S3 (um MinIO local).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pulso-cozinha
# KITCHEN_S3_ENDPOINT=
